{
  "name": "storybook-packager",
  "description": "Storybook Packager desktop application",
  "author": "Ethan Lin <elin@excelsior.edu>",
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:next": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && npm run build:electron && cross-env ELECTRON_START_URL=http://localhost:3000 electron dist-electron/main.js",
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:electron\"",
    "start": "next start",
    "build:electron": "tsc -p tsconfig.electron.json && copy electron\\preload.cjs dist-electron\\preload.cjs",
    "build:next": "next build",
    "predist": "node -e \"require('fs').mkdirSync('node_modules/@img/sharp-darwin-arm64', { recursive: true });\"",
    "dist": "npm run build:next && electron-builder"
  },
  "build": {
    "appId": "edu.excelsior.storybook-packager",
    "directories": {
      "buildResources": "public/icons",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "dist-electron/main.js",
      "electron/preload.cjs",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "files": [
        "out/**/*",
        "dist-electron/main.js",
        "electron/preload.cjs",
        "package.json",
        "!**/node_modules/@img/sharp-darwin-arm64",
        "!node_modules/@img/sharp-darwin-arm64"
      ],
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "icon.icns",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "electron-default-menu": "^1.0.2",
    "next": "15.3.1",
    "react": "^19.0.0",
    "react-bootstrap-icons": "^1.11.5",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "daisyui": "^5.0.32",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  }
}
