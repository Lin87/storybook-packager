{
    "name": "storybook-packager",
    "description": "Storybook Packager desktop application",
    "author": "Ethan Lin <elin@excelsior.edu>",
    "version": "0.1.0",
    "main": "dist-electron/electron/main.js",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:next": "next dev",
        "start:electron:dev": "wait-on http://localhost:3000 && node env-scripts/start-electron-dev.cjs",
        "start:electron:prod": "node env-scripts/build-and-start-electron-prod.cjs",
        "dev": "concurrently -n NEXT,ELECTRON -c green,blue \"npm run dev:next\" \"npm run start:electron:dev\"",
        "build:prod": "npm run build:next && npm run build:electron && npm run predist && electron-builder",
        "build:next": "next build",
        "test:compat": "node --test tests/sbplus-compatibility.test.cjs",
        "build:electron": "tsc -p tsconfig.electron.json",
        "predist": "node -e \"require('fs').mkdirSync('node_modules/@img/sharp-darwin-arm64', { recursive: true });\""
    },
    "build": {
        "appId": "edu.excelsior.storybook-packager",
        "directories": {
            "buildResources": "public/icons",
            "output": "dist"
        },
        "files": [
            "out/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "win": {
            "icon": "icon.ico",
            "files": [
                "out/**/*",
                "dist-electron/**/*",
                "package.json",
                "!**/node_modules/@img/sharp-darwin-arm64",
                "!node_modules/@img/sharp-darwin-arm64"
            ],
            "target": [
                "nsis"
            ]
        },
        "mac": {
            "icon": "icon.icns",
            "target": [
                "dmg"
            ]
        },
        "linux": {
            "icon": "icon.png",
            "target": [
                "AppImage"
            ]
        }
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@floating-ui/react": "^0.27.20",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-popover": "^1.1.23",
        "@tiptap/extension-subscript": "^3.31.0",
        "@tiptap/extension-superscript": "^3.31.0",
        "@tiptap/pm": "^3.31.0",
        "@tiptap/react": "^3.31.0",
        "@tiptap/starter-kit": "^3.31.0",
        "clsx": "^2.1.1",
        "electron-default-menu": "^1.0.2",
        "express": "^5.2.1",
        "get-port": "^7.2.0",
        "next": "^16.3.4",
        "react": "^19.2.8",
        "react-bootstrap-icons": "^1.11.6",
        "react-dom": "^19.2.8",
        "sharp": "^0.35.4",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "@base-ui/react": "^1.7.0",
        "@eslint/eslintrc": "^3.3.7",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/express": "^5.0.6",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/xml2js": "^0.4.14",
        "class-variance-authority": "^0.7.1",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "daisyui": "^5.7.27",
        "electron": "^44.1.1",
        "electron-builder": "^26.15.3",
        "eslint": "^10.9.1",
        "eslint-config-next": "16.3.4",
        "sass": "^1.103.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "wait-on": "^9.1.0"
    }
}
