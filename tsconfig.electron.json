{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "outDir": "dist-electron",
        "rootDir": "src",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "baseUrl": "src",
        "paths": {
            "@/*": ["*"]
        }
    },
    "include": ["src/electron/main.ts"],
    "exclude": ["src/types"]
}
