{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "outDir": "dist-electron",
        "rootDir": "src",
        "esModuleInterop": true,
        "strict": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/electron/**/*.ts"],
    "exclude": ["src/types"]
}
